# ==============================================================================
# VisionTrack — Environment Variables Configuration
# Copy this file to .env and set the appropriate values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# REQUIRED: Secret key used to sign and verify JWT tokens.
# App will REFUSE TO START if this variable is not set.
JWT_SECRET=your_super_strong_production_jwt_secret_change_this

# Port for Express server. Railway and Render inject this automatically.
# Default: 3001
PORT=3001

# Path to SQLite database file.
# IMPORTANT: On Railway/Render, point this to a mounted persistent volume
# (e.g., /data/anpr.db) to prevent data loss across restarts/deployments.
# Default: ./anpr.db
DB_PATH=/data/anpr.db

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND DOMAINS
# ------------------------------------------------------------------------------
# Allowed origins for HTTP API and Socket.IO connections.
# Comma-separated list of domains, or '*' for all. Localhost is always allowed.
# Example: https://visiontrack-frontend.vercel.app,https://visiontrack.up.railway.app
ALLOWED_ORIGINS=

# Frontend build-time API base URL.
# Leave unset if dashboard and backend are served from the same domain/container.
# Example: https://visiontrack-api.up.railway.app
VITE_API_URL=

# ------------------------------------------------------------------------------
# 3. LOGGING & DIAGNOSTICS (LOG NOISE CONTROL)
# ------------------------------------------------------------------------------
# Set to 'true' to enable verbose per-frame ANPR diagnostic output.
# Recommended: false in production to prevent log flooding.
DEBUG_ANPR=false

# Set to 'true' to enable verbose per-call neural OCR candidate debug logs.
# Recommended: false in production.
DEBUG_OCR=false

# General debug toggle (enables all debug logs if 'true')
DEBUG=false

# ------------------------------------------------------------------------------
# 4. FFMPEG & VIDEO INGESTION
# ------------------------------------------------------------------------------
# Path to ffmpeg binary. When deployed via Dockerfile, ffmpeg is installed in PATH.
# Default: ffmpeg
FFMPEG_PATH=ffmpeg

# RTSP / Video pipeline target sample frame rate (FPS)
ANPR_SAMPLE_FPS=16
VIDEO_SAMPLE_FPS=16
RTSP_SAMPLE_FPS=16
FRAME_SAMPLE_FPS=16

# RTSP max reconnect retries
RTSP_MAX_RETRIES=5

# Maximum uploaded video file size in bytes (default 2GB)
MEDIA_FILE_LIMIT_BYTES=2147483648

# ------------------------------------------------------------------------------
# 5. CAMERA & OCR ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# HTTP JSON body payload limit for high-res camera frames
CAMERA_PAYLOAD_LIMIT=50mb
CAMERA_IMAGE_LIMIT_BYTES=52428800

# Number of intra-op ONNX threads for inference (default: 4-6)
ONNX_NUM_THREADS=4

# Optional: Plate Recognizer Cloud API token (used only for diagnostic routes)
PLATE_RECOGNIZER_TOKEN=
PLATE_RECOGNIZER_ENABLED=false

# Time window in seconds to deduplicate detections of the same plate
ANPR_DEDUP_WINDOW_SECONDS=5
